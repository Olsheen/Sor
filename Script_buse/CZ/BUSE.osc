{macro:Matrix_init}
	0 (S.L.Matrix_TerminusIndex_Last)
	0 (S.L.Matrix_Nr_Last)
	"@@@@@@@@@@@...........................................1...........................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.....................1.................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.......................................................................................................................................@.................................................................1.....................................................................@.......................................................................................................................................@.................................................................................................................................1..... " (S.$.Matrix_Terminus)
	"   " (S.$.Matrix_Nr)
{end}

{trigger:ai_scheduled_settarget}
'	Stromversorgung herstellen:
	1 (S.L.elec_busbar_main_sw)	
	1.0 (S.L.elec_V_battery)

'	Hier wird die Nummer eingestellt:
	(L.$.SetLineTo) 3 $SetLengthL (S.$.Matrix_Nr)

'	Hier wird das Ziel eingestellt:
	1 (S.L.elec_busbar_main_sw)

'	AI uses LED-BUSE because it doesnt affect FPS
	(L.L.AI_target_index) (S.L.target_index_int)
	(L.L.AI_target_index) 1 (M.V.GetTerminusString) (S.$.Matrix_Terminus)
	(L.L.AI_target_index) 0 (M.V.GetTerminusString) (S.$.IBIS_terminus_name2)
	(L.L.AI_target_index) 1 (M.V.GetBusstopString) (S.$.pres_zastavky_p_panel) 
	1 (S.L.Refresh_Strings)
{end}

{macro:Matrix_frame}



'******************************
'    Terminus-Matrix
'******************************

	(L.L.Matrix_IBIS_TerminusIndex_Last) (L.L.IBIS_TerminusIndex) = !
	{if}
		(L.L.IBIS_TerminusIndex) (S.L.Matrix_TerminusIndex)
		(L.L.IBIS_TerminusIndex) (S.L.Matrix_IBIS_TerminusIndex_Last)
		0 (S.L.Matrix_Wechselziel-Timer)
	{endif}

' 	Zeitdifferenz:
	(L.S.GetTime) (L.L.Matrix_TerminusActTimer) - s2

	l2 0 <
	{if}
		(L.S.GetTime) (S.L.Matrix_TerminusActTimer) 0 s2
		1 (S.L.Matrix_TerminusCreateString)
	{endif}

' 	Ob der Suffix >= 94 ist, speichere in s4:
	(L.L.IBIS_Linie_Suffix) 94 >= s4

'	Changecounter zurücksetzen: (wenn kein Wechselziel angezeigt wird)
	(L.L.mpc_linka) 970 <=
	(L.L.IBIS_Linie_Suffix) 96 = ! &&
	(L.L.IBIS_Linie_Suffix) 95 = ! &&
	{if}
		0 (S.L.Matrix_ChangeCounter)
	{endif}

'	Wenn sich das neue Ziel vom alten unterscheidet, dann wechsele:
	l4 ! (L.L.IBIS_TerminusIndex) s0 (L.L.Matrix_TerminusIndex_Last) = !  &&

' 	ODER wenn die Nummer eine "zielbeeinflussende" ist und ungleich dem negativen Matrix_terminusIndex_Last:
	l4 (L.L.IBIS_Linie_Suffix) s1 /-/ (L.L.Matrix_TerminusIndex_Last) = ! && ||
	(L.L.elec_busbar_main) &&
	{if}
		l2 (C.L.Matrix_Waittime) (C.L.Matrix_Changetime_Terminus) 3.5 * + <
		{if}
			l2 (C.L.Matrix_Waittime) >
			{if}
' 				Nur beim ersten Mal:
				(L.L.Matrix_TerminusCreateString)
				{if}
' 				Zmìna BUSE
					(L.L.mpc_linka) 910 =
					{if}
						"@@@@@@@@@@@111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111@111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111@111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111@11111111111111111111111111111111111111111111111111111111111111111111..1..111111111..111111111111111..1111111111111111111111111111111111@111111111111111111111111111111111111111111111111111111111111111111111...111111111..111111111111111..11111111111111111111111111111111111@111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111@11111111111111..111..111....11..11..1..1.....11..11..1..11111....111....11..11..1..11111111......1..11.......1.....111....1111111111111@11111111111111...1...11......1..11..1..1......1..11..1..1111......1......1..11..1..11111111......1..11.......1......1......111111111111@11111111111111.......11..11..1...1..1..1..11..1..11..1..1111..11..1..11..1...1..1..111111111111..1..1111111..1..11..1..11..111111111111@11111111111111.......11..11..1......1..1..11..1..11..1..1111..11..1..11111......1..111111111111..1..1111111..1..11..1..11..111111111111@11111111111111..1.1..11..11..1......1..1..11..1..11..1..1111..11..1..11111......1..111111111111..1..111111...1..11..1..11..111111111111@11111111111111..111..11......1..1...1..1......1..11..1..1111......1..11111..1...1..111111111111..1..11111...11..11..1......111111111111@11111111111111..111..11......1..11..1..1.....11..11..1..1111......1..11111..11..1..111111111111..1..1111...111..11..1......111111111111@11111111111111..111..11..11..1..11..1..1..11111..11..1..1111..11..1..11111..11..1..111111111111..1..111...1111..11..1..11..111111111111@11111111111111..111..11..11..1..11..1..1..11111..11..1..1111..11..1..11111..11..1..111111111111..1..11...11111..11..1..11..111111111111@11111111111111..111..11..11..1..11..1..1..11111..11..1..1111..11..1..11111..11..1..11111111..11..1..11..111111..11..1..11..111111111111@11111111111111..111..11..11..1..11..1..1..11111..11..1..1111..11..1..11..1..11..1..11111111..11..1..11..111111..11..1..11..111111111111@11111111111111..111..11..11..1..11..1..1..11111......1.....1..11..1......1..11..1..11111111......1..11.......1......1..11..111111111111@11111111111111..111..11..11..1..11..1..1..111111....11.....1..11..11....11..11..1..111111111....11..11.......1.....11..11..111111111111@111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111@111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111@111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111 " (S.$.Matrix_NewTerminus)
					{else}

					
					(L.L.Matrix_TerminusIndex) 1 (M.V.GetTerminusString) (S.$.Matrix_NewTerminus)
					{endif}
					

					
				
		
	
					
					
					0 (S.L.Matrix_TerminusCreateString)
					(T.L.ev_Matrix_Terminus_change)

'					Das soeben in den temporären Speicher geschriebene Ziel:
					l4
					{if}
						l1 /-/ 
					{else}
						l0 
					{endif}
					(S.L.Matrix_TerminusAct)
				{endif}

'				Zahl von aktualisierten Zeichen:
				l2 (C.L.Matrix_Waittime) - 0 max 135 * (C.L.Matrix_Changetime_Terminus) / trunc 135 min s3

'					Rozcleneni cile na jednotlive radky
					(L.$.Matrix_NewTerminus) 11 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_01)
					(L.$.Matrix_NewTerminus) 147 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_02)
					(L.$.Matrix_NewTerminus) 283 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_03)
					(L.$.Matrix_NewTerminus) 419 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_04)
					(L.$.Matrix_NewTerminus) 555 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_05)
					(L.$.Matrix_NewTerminus) 691 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_06)
					(L.$.Matrix_NewTerminus) 827 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_07)
					(L.$.Matrix_NewTerminus) 963 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_08)
					(L.$.Matrix_NewTerminus) 1099 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_09)
					(L.$.Matrix_NewTerminus) 1235 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_10)
					(L.$.Matrix_NewTerminus) 1371 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_11)
					(L.$.Matrix_NewTerminus) 1507 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_12)
					(L.$.Matrix_NewTerminus) 1643 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_13)
					(L.$.Matrix_NewTerminus) 1779 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_14)
					(L.$.Matrix_NewTerminus) 1915 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_15)
					(L.$.Matrix_NewTerminus) 2051 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_16)
					(L.$.Matrix_NewTerminus) 2187 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_17)
					(L.$.Matrix_NewTerminus) 2323 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_18)
					(L.$.Matrix_NewTerminus) 2459 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_19)
					(L.$.Matrix_NewTerminus) 2595 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_20)
					(L.$.Matrix_NewTerminus) 2731 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_21)
					(L.$.Matrix_NewTerminus) 2867 $cutBegin 135 $SetLengthL (S.$.BUSE_ciel_riadok_22)

					(L.$.Matrix_Terminus) 11 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_01)
					(L.$.Matrix_Terminus) 147 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_02)
					(L.$.Matrix_Terminus) 283 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_03)
					(L.$.Matrix_Terminus) 419 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_04)
					(L.$.Matrix_Terminus) 555 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_05)
					(L.$.Matrix_Terminus) 691 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_06)
					(L.$.Matrix_Terminus) 827 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_07)
					(L.$.Matrix_Terminus) 963 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_08)
					(L.$.Matrix_Terminus) 1099 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_09)
					(L.$.Matrix_Terminus) 1235 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_10)
					(L.$.Matrix_Terminus) 1371 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_11)
					(L.$.Matrix_Terminus) 1507 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_12)
					(L.$.Matrix_Terminus) 1643 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_13)
					(L.$.Matrix_Terminus) 1779 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_14)
					(L.$.Matrix_Terminus) 1915 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_15)
					(L.$.Matrix_Terminus) 2051 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_16)
					(L.$.Matrix_Terminus) 2187 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_17)
					(L.$.Matrix_Terminus) 2323 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_18)
					(L.$.Matrix_Terminus) 2459 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_19)
					(L.$.Matrix_Terminus) 2595 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_20)
					(L.$.Matrix_Terminus) 2731 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_21)
					(L.$.Matrix_Terminus) 2867 $cutBegin 135 $SetLengthL (S.$.BUSE_puv_riadok_22)
				
				l3 1 >=
				{if}

						(L.$.BUSE_ciel_riadok_01) l3 $SetLengthL (L.$.BUSE_puv_riadok_01) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_01)
						(L.$.BUSE_ciel_riadok_02) l3 $SetLengthL (L.$.BUSE_puv_riadok_02) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_02)
						(L.$.BUSE_ciel_riadok_03) l3 $SetLengthL (L.$.BUSE_puv_riadok_03) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_03)
						(L.$.BUSE_ciel_riadok_04) l3 $SetLengthL (L.$.BUSE_puv_riadok_04) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_04)
						(L.$.BUSE_ciel_riadok_05) l3 $SetLengthL (L.$.BUSE_puv_riadok_05) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_05)
						(L.$.BUSE_ciel_riadok_06) l3 $SetLengthL (L.$.BUSE_puv_riadok_06) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_06)
						(L.$.BUSE_ciel_riadok_07) l3 $SetLengthL (L.$.BUSE_puv_riadok_07) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_07)
						(L.$.BUSE_ciel_riadok_08) l3 $SetLengthL (L.$.BUSE_puv_riadok_08) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_08)
						(L.$.BUSE_ciel_riadok_09) l3 $SetLengthL (L.$.BUSE_puv_riadok_09) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_09)
						(L.$.BUSE_ciel_riadok_10) l3 $SetLengthL (L.$.BUSE_puv_riadok_10) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_10)
						(L.$.BUSE_ciel_riadok_11) l3 $SetLengthL (L.$.BUSE_puv_riadok_11) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_11)
						(L.$.BUSE_ciel_riadok_12) l3 $SetLengthL (L.$.BUSE_puv_riadok_12) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_12)
						(L.$.BUSE_ciel_riadok_13) l3 $SetLengthL (L.$.BUSE_puv_riadok_13) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_13)
						(L.$.BUSE_ciel_riadok_14) l3 $SetLengthL (L.$.BUSE_puv_riadok_14) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_14)
						(L.$.BUSE_ciel_riadok_15) l3 $SetLengthL (L.$.BUSE_puv_riadok_15) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_15)
						(L.$.BUSE_ciel_riadok_16) l3 $SetLengthL (L.$.BUSE_puv_riadok_16) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_16)
						(L.$.BUSE_ciel_riadok_17) l3 $SetLengthL (L.$.BUSE_puv_riadok_17) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_17)
						(L.$.BUSE_ciel_riadok_18) l3 $SetLengthL (L.$.BUSE_puv_riadok_18) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_18)
						(L.$.BUSE_ciel_riadok_19) l3 $SetLengthL (L.$.BUSE_puv_riadok_19) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_19)
						(L.$.BUSE_ciel_riadok_20) l3 $SetLengthL (L.$.BUSE_puv_riadok_20) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_20)
						(L.$.BUSE_ciel_riadok_21) l3 $SetLengthL (L.$.BUSE_puv_riadok_21) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_21)
						(L.$.BUSE_ciel_riadok_22) l3 $SetLengthL (L.$.BUSE_puv_riadok_22) l3 $cutBegin $+ (S.$.BUSE_ciel_riadok_22)

						"@@@@@@@@@@@" 
						(L.$.BUSE_ciel_riadok_01) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_02) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_03) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_04) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_05) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_06) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_07) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_08) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_09) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_10) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_11) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_12) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_13) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_14) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_15) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_16) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_17) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_18) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_19) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_20) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_21) "@" $+ $+ 
						(L.$.BUSE_ciel_riadok_22) "@" $+ $+ 
						(S.$.Matrix_Terminus)
						
						1 (S.L.Refresh_Strings)
				{endif}
			{endif}
			{else}
			(L.L.mpc_linka) 980 >=
			{if}
				(L.L.Matrix_ChangeCounter) ! (S.L.Matrix_ChangeCounter)
'				Hierdurch wird der Wechsel der Nummern-Matrix initiiert:
				-1 (S.L.Matrix_Nr_Last)
			{else}
				(L.L.Matrix_TerminusAct) (S.L.Matrix_TerminusIndex_Last) (S.L.target_index_int)
			{endif}
			1 (S.L.Matrix_TerminusCreateString)
		{endif}


'		Omsi sagen, dass die Strings-Ausgaben aktualisiert werden sollen:
		1 (S.L.Refresh_Strings)
	
	{else}
		(L.S.GetTime) (S.L.Matrix_TerminusActTimer)
		1 (S.L.Matrix_TerminusCreateString)
	{endif}

'******************************+
'    Nr-Matrix
'******************************+
'	Zeitdifferenz:
	(L.S.GetTime) (L.L.Matrix_NrActTimer) - s2

	l2 0 <
	{if}
		(L.S.GetTime) (S.L.Matrix_NrActTimer) 0 s2
		1 (S.L.Matrix_NrCreateString)
	{endif}

'	Wenn sich die neue Linie von der alten unterscheidet, dann wechsele:
	(L.L.IBIS_Linie_Complex) s0 (L.L.Matrix_Nr_Last) = ! 
	(L.L.elec_busbar_main) &&
	{if}
		l2 (C.L.Matrix_Waittime) (C.L.Matrix_Changetime_Nr) 1.5 * + <
		{if}
			l2 (C.L.Matrix_Waittime) >
			{if}
'				Nur beim ersten Mal:
				(L.L.Matrix_NrCreateString)
				{if}
					l0 100 / trunc s1
					(L.L.IBIS_Linie_Suffix) s4
'					l0: Originalzahl; l1: erste drei Ziffern; l4: letzte zwei Ziffern
'					Falls gleich 0, dann gar nix:
					l1 0 =
					{if}
						""
					{else}
'						Sonst die normale Nummer:
						l1 trunc $IntToStr
					{endif}

					(S.$.Matrix_NewNr)

' ===============================================================================
' Falls jetzt die hinteren beiden Ziffern l2 etwas Interessantes enthalten:
' ===============================================================================
'					Zunächst wird verlängert, wenn einstellig - und zwar je nach Anwendung links- oder rechtsbündig:
				
					(L.L.mpc_linka) 910 =
					{if}
						"d"
					{endif}
					
					(L.L.mpc_linka) 912 =
					{if}
						"d"
					{endif}
					
					(L.L.mpc_linka) 920 =
					{if}
						"d" 
					{endif}
					
					(L.L.mpc_linka) 743 =
					{if}
						"d"
					{endif}
					
					(L.L.mpc_linka) 740 =
					{if}
						"d"
					{endif}
					
					(L.L.mpc_linka) 913 =
					{if}
						"^"
					{endif}

					(S.$.Matrix_NewNr)

					0 (S.L.Matrix_NrCreateString)
					(T.L.ev_Matrix_Line_change)
					l0 (S.L.Matrix_NrAct)
				{endif}

'				Zahl von aktualisierten Zeichen:
				l2 (C.L.Matrix_Waittime) - 0 max 3 * (C.L.Matrix_Changetime_Nr) / trunc 3 min s3

				l3 1 >=
				{if}
					(L.$.Matrix_NewNr) (S.$.Matrix_Nr)
				{endif}
			{endif}
		{else}
			(L.L.Matrix_NrAct) (S.L.Matrix_Nr_Last)
			(L.$.Matrix_NewNr) (S.$.Matrix_Nr)
			1 (S.L.Matrix_NrCreateString)
			(L.S.GetTime) (S.L.Matrix_NrActTimer)
		{endif}		
'		Omsi sagen, dass die Strings-Ausgaben aktualisiert werden sollen:
		1 (S.L.Refresh_Strings)
	{else}
		(L.S.GetTime) (S.L.Matrix_NrActTimer)
		1 (S.L.Matrix_NrCreateString)
	{endif}

'	Aktualisierung der Code-Tafel:
	"Linienlisten\" (L.$.yard) "_ANX.jpg" $+ $+ (S.$.Matrix_Linelist)

{end}

