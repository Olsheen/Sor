{macro:menu_text_frame}


		
		(L.L.menu_dolni) 1 = 
	    (L.L.navigator_menu_visible) 1 = &&
		{if}
		"TARIF* MÏNA  *  MEM  * RevJi *       * SlHla" (S.$.kasa_menu_text_dolniR)
