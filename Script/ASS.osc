'##############
'ASS: Exterior urban warning sound
'##############

'Simulates the pedestrian alarm for TC vehicles (Sesaly ASS)

'Script Version: 1.0
'Omsi release: 2.03.004

'Needs:
'- elec

'Revision History:
'- NEROSY  25.01.2023  [Iveco Bus Urbanway-Familie] Adding the selection of several tones

'----------------------
'	Trigger
'----------------------

{trigger:cp_ASS_toggle}
    (L.L.ASS_triggering) 2 =
    {if}
        0 (S.L.ASS_triggering)
    {else}
        1 (S.L.ASS_triggering)
    {endif}
    (T.L.ASS_on)
{end}

{trigger:cp_ASS_toggle_off}
    (L.L.ASS_triggering) 1 =
    {if}
      0 (S.L.ASS_triggering)
    {endif}
    (T.L.ASS_on)
{end}

{trigger:ASS_keyboard_change_tone}
    (L.L.ASS_select_tone) 0 =
    {if}
        1 (S.L.ASS_select_tone)
    {endif}
    (L.L.ASS_select_tone) 1 =
    {if}
        2 (S.L.ASS_select_tone)
    {endif}
    (L.L.ASS_select_tone) 2 =
    {if}
        3 (S.L.ASS_select_tone)
    {endif}
    (L.L.ASS_select_tone) 3 =
    {if}
        0 (S.L.ASS_select_tone)
    {endif}
{end}

'----------------------
'	Frame
'----------------------

{macro:ASS_frame}
    (L.L.elec_busbar_main) (C.L.elec_busbar_minV) >
    {if}
        (L.L.ASS_select_tone) 0 =
        {if}
            (L.S.GetTime) (L.L.ASS_play_Timegap) - 1.01175 >=
            (L.L.ASS_triggering) &&
            (L.L.elec_busbar_main) &&
            {if}
                (T.L.ASS_tone_1)
                (L.S.GetTime) (S.L.ASS_play_Timegap)
            {endif}
        {endif}
        (L.L.ASS_select_tone) 1 =
        {if}
            (L.S.GetTime) (L.L.ASS_play_Timegap) - 0.638163 >=
            (L.L.ASS_triggering) &&
            (L.L.elec_busbar_main) &&
            {if}
                (T.L.ASS_tone_2)
                (L.S.GetTime) (S.L.ASS_play_Timegap)
            {endif}
        {endif}
        (L.L.ASS_select_tone) 2 =
        {if}
            (L.S.GetTime) (L.L.ASS_play_Timegap) - 0.8 >=
            (L.L.ASS_triggering) &&
            (L.L.elec_busbar_main) &&
            {if}
                (T.L.ASS_tone_3)
                (L.S.GetTime) (S.L.ASS_play_Timegap)
            {endif}
        {endif}
        (L.L.ASS_select_tone) 3 =
        {if}
            (L.S.GetTime) (L.L.ASS_play_Timegap) - 1.026372 >=
            (L.L.ASS_triggering) &&
            (L.L.elec_busbar_main) &&
            {if}
                (T.L.ASS_tone_4)
                (L.S.GetTime) (S.L.ASS_play_Timegap)
            {endif}
        {endif}
    {endif}
    (L.L.ASS_select_tone) 4 =
    {if}
        (L.S.GetTime) (L.L.ASS_play_Timegap) - 0.6 >=
        (L.L.ASS_triggering) &&
        (L.L.elec_busbar_main) &&
        {if}
            (T.L.ASS_tone_5)
            (L.S.GetTime) (S.L.ASS_play_Timegap)
        {endif}
    {endif}
{end}