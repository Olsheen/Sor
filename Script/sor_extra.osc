	(L.L.sor_sw_p22) ! (S.L.sor_sw_p22)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p24}
	(L.L.sor_sw_p24) ! (S.L.sor_sw_p24)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p26}
	(L.L.sor_sw_p26) ! (S.L.sor_sw_p26)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p32}
	(L.L.sor_sw_p32) ! (S.L.sor_sw_p32)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p37}
	(L.L.sor_sw_p37) ! (S.L.sor_sw_p37)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p38}
	(L.L.sor_sw_p38) ! (S.L.sor_sw_p38)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p4}
	(L.L.sor_sw_p4) ! (S.L.sor_sw_p4)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p41}
	(L.L.sor_sw_p41) ! (S.L.sor_sw_p41)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p42}
	(L.L.sor_sw_p42) ! (S.L.sor_sw_p42)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p47}
	(L.L.sor_sw_p47) ! (S.L.sor_sw_p47)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p49}
	(L.L.sor_sw_p49) ! (S.L.sor_sw_p49)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p5}
	(L.L.sor_sw_p5) ! (S.L.sor_sw_p5)
	(T.L.ev_Actia_BTN_pushed)
{end}
