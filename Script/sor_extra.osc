'##############################################
' SOR NS 12 DIESEL - doplnkove funkce (generovano write_scripts.py)
' denni sviceni, sloucene koncove/brzdove svetlo, vystrazna svetla dveri,
' otackomer a palivomer palubni desky SOR, rezim BUSE panelu
'##############################################

{macro:sor_extra_init}
	0 (S.L.door_warn_timer) (S.L.door_warn_phase)
	-1 (S.L.sor_cil_last_index)
	"" (S.$.sor_cil_text)
{end}

{macro:sor_extra_frame}

' --- denni sviceni: LED kruhy sviti pri zapnutem napajeni, dokud nejsou zapnuta obrysova svetla
	(L.L.elec_busbar_main) (C.L.elec_busbar_minV) > (L.L.lights_stand) 0.5 < &&
	{if}
		1
	{else}
		0
	{endif}
	(S.L.lights_denni)

' --- koncove + brzdove svetlo v jedne svitilne (brzda = plny jas, obrys = 35 %)
	(L.L.lights_brems) 0.5 >
	{if}
		1
	{else}
		(L.L.lights_stand) 0.35 *
	{endif}
	(S.L.lights_brems_komb)

' --- zavirani dveri SOR: nejdriv vystraha (zvuk + cervena svetla), pak se dvere zavrou
	(L.L.sor_close_req_0)
	{if}
		(L.L.sor_close_timer_0) (L.S.Timegap) + (S.L.sor_close_timer_0)
		2.0 >
		{if}
			0 (S.L.sor_close_req_0) (S.L.doorTarget_0)
			(T.L.ev_doortriggerclose_0)
		{endif}
	{endif}
	(L.L.sor_close_req_1)
	{if}
		(L.L.sor_close_timer_1) (L.S.Timegap) + (S.L.sor_close_timer_1)
		2.0 >
		{if}
			0 (S.L.sor_close_req_1) (S.L.doorTarget_1)
			(T.L.ev_doortriggerclose_1)
		{endif}
	{endif}
	(L.L.sor_close_req_23)
	{if}
		(L.L.sor_close_timer_23) (L.S.Timegap) + (S.L.sor_close_timer_23)
		3.0 >
		{if}
			0 (S.L.sor_close_req_23) (S.L.doorTarget_23)
			(L.L.bode2_f) ! {if} (L.L.ver_phase) ! {if} (T.L.ev_doortriggerclose_2) {else} (T.L.ev_doortriggerclose_2_D) {endif} {else} (L.L.ver_phase) ! {if} (T.L.ev_doortriggerclose_2_B) {else} (T.L.ev_doortriggerclose_2_B_D) {endif} {endif}
		{endif}
	{endif}
	(L.L.sor_close_req_45)
	{if}
		(L.L.sor_close_timer_45) (L.S.Timegap) + (S.L.sor_close_timer_45)
		3.0 >
		{if}
			0 (S.L.sor_close_req_45) (S.L.doorTarget_45)
			(L.L.bode3_f) ! {if} (L.L.ver_phase) ! {if} (T.L.ev_doortriggerclose_3) {else} (T.L.ev_doortriggerclose_3_D) {endif} {else} (L.L.ver_phase) ! {if} (T.L.ev_doortriggerclose_3_B) {else} (T.L.ev_doortriggerclose_3_B_D) {endif} {endif}
		{endif}
	{endif}
	(L.L.sor_close_req_0) (L.L.sor_close_req_1) || (L.L.doorTarget_0) 0.5 < (L.L.door_0) (L.L.door_1) max 0.02 > && || (L.L.elec_busbar_main) 0.5 > && (S.L.door_warn_1)
	(L.L.sor_close_req_23) (L.L.doorTarget_23) 0.5 < (L.L.door_2) (L.L.door_3) max 0.02 > && || (L.L.elec_busbar_main) 0.5 > && (S.L.door_warn_2)
	(L.L.sor_close_req_45) (L.L.doorTarget_45) 0.5 < (L.L.door_4) (L.L.door_5) max 0.02 > && || (L.L.elec_busbar_main) 0.5 > && (S.L.door_warn_3)


' --- otackomer (pravy budik, 0..3000 1/min) a palivomer (maly budik pod rychlomerem)
	(L.L.engine_n) (F.L.sor_otackomer) (L.L.elec_busbar_main) 0.5 > * (S.L.cockpit_otackomer_winkel)
	(L.L.cockpit_tankuhr) (C.L.sor_palivo_kapacita) / (F.L.sor_palivomer) (S.L.cockpit_tankuhr_winkel)

' --- palubka SOR: kontrolky a podsviceni tlacitek
	(L.L.cockpit_gang3) (L.L.cockpit_gangR) || ! (L.L.elec_busbar_main) 0.5 > && (S.L.sor_gear_N)
	(L.L.door_0) (L.L.door_1) max (L.L.door_2) max (L.L.door_3) max (L.L.door_4) max (L.L.door_5) max 0.02 >
	(L.L.elec_busbar_main) 0.5 > && (S.L.sor_lamp_doors)
	(L.L.elec_busbar_main) (C.L.elec_busbar_minV) > (L.L.engine_n) 300 < && (S.L.sor_lamp_test)
	(L.L.antrieb_retarderstufe) 0 > (L.L.elec_busbar_main) 0.5 > && (S.L.sor_lamp_retarder)

' --- slunecni roleta: pasy se ukazuji podle vytazeni (cp_rollo_pos)
	(L.L.cp_rollo_pos) 12 * 0.5 > (S.L.sor_rollo_1)
	(L.L.cp_rollo_pos) 12 * 1.5 > (S.L.sor_rollo_2)
	(L.L.cp_rollo_pos) 12 * 2.5 > (S.L.sor_rollo_3)
	(L.L.cp_rollo_pos) 12 * 3.5 > (S.L.sor_rollo_4)
	(L.L.cp_rollo_pos) 12 * 4.5 > (S.L.sor_rollo_5)
	(L.L.cp_rollo_pos) 12 * 5.5 > (S.L.sor_rollo_6)
	(L.L.cp_rollo_pos) 12 * 6.5 > (S.L.sor_rollo_7)
	(L.L.cp_rollo_pos) 12 * 7.5 > (S.L.sor_rollo_8)
	(L.L.cp_rollo_pos) 12 * 8.5 > (S.L.sor_rollo_9)
	(L.L.cp_rollo_pos) 12 * 9.5 > (S.L.sor_rollo_10)
	(L.L.cp_rollo_pos) 12 * 10.5 > (S.L.sor_rollo_11)
	(L.L.cp_rollo_pos) 12 * 11.5 > (S.L.sor_rollo_12)


' --- BUSE: cil jako bitmapa z BUSE hofu (retezec 1 zacina '@@@@'), jinak textovy cil (retezec 0)
	(L.L.IBIS_TerminusIndex) (L.L.sor_cil_last_index) = !
	{if}
		(L.L.IBIS_TerminusIndex) (S.L.sor_cil_last_index)
		(L.L.IBIS_TerminusIndex) 0 (M.V.GetTerminusString) (S.$.sor_cil_text)
	{endif}
	(L.L.elec_busbar_main) (C.L.elec_busbar_minV) > s0
	l0 (S.L.sor_buse_on)
	(L.$.Matrix_Terminus) 4 $SetLengthL "@@@@" $= s1
	l0 l1 && (S.L.sor_buse_bmp)
	l0 l1 ! && (S.L.sor_buse_txt)
{end}

' --- otocny prepinac svetel SOR: vypnuto -> obrysova -> potkavaci -> vypnuto
{trigger:sor_lichtschalter}
	(L.L.cp_schluessel_rot) s0 0.25 <
	{if}
		0.5 (S.L.cp_schluessel_rot)
		1 (S.L.actia_schluessel_rot)
	{else}
		l0 0.75 <
		{if}
			1 (S.L.cp_schluessel_rot)
			2.17 (S.L.actia_schluessel_rot)
		{else}
			0 (S.L.cp_schluessel_rot)
			0 (S.L.actia_schluessel_rot)
			0 (S.L.actia_schluessel_trans)
		{endif}
	{endif}
	(T.L.ev_schluessel_dreh)
{end}

' --- hlavni vypinac (zelene I / cervene O na leve konzoli)
{trigger:sor_batt_on}
	(L.L.elec_busbar_main_sw) !
	{if}
		1 (S.L.elec_button_on)
		1 (S.L.elec_busbar_main_sw)
		0 (S.L.Timer_elec_on)
		(T.L.ev_sor_baterie)
	{endif}
{end}

{trigger:sor_batt_off}
	(L.L.elec_busbar_main_sw)
	{if}
		0 (S.L.elec_busbar_main_sw)
		1 (S.L.elec_button_off)
		(T.L.ev_sor_baterie)
	{endif}
{end}

{trigger:sor_sw_p14}
	(L.L.sor_sw_p14) ! (S.L.sor_sw_p14)
	(T.L.ev_Actia_BTN_pushed)
{end}

{trigger:sor_sw_p15}
	(L.L.sor_sw_p15) ! (S.L.sor_sw_p15)
	(T.L.ev_Actia_BTN_pushed)
{end}

