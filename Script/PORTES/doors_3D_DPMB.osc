              {endif}
            {endif}
          {endif}
        {else}
          (L.L.door_0) (F.L.door_0_cls_speed) (S.L.doorMaxSpeed_0)
          l0 /-/ (L.L.doorMaxSpeed_0) <
          {if}
            (L.L.doorSpeed_0) (L.L.doorAcc_0) (L.S.Timegap) * - (S.L.doorSpeed_0)
