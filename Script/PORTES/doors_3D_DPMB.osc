{macro:trg_bus_doorfront0}

  (L.L.doorfront_emergency) !
  {if}
    (L.L.doorTarget_0) !
    {if}
      1 (S.L.doorTarget_0)
      0 (S.L.sor_close_req_0)
      (T.L.ev_doortriggeropen_0)
    {else}
      (L.L.sor_close_req_0) !
      {if}
        1 (S.L.sor_close_req_0)
        0 (S.L.sor_close_timer_0)
        (T.L.ev_sor_doorwarn_1)
      {else}
        0 (S.L.sor_close_req_0)
      {endif}
    {endif}
    (C.L.door_druckluft)
    {if}
      (L.L.bremse_p_Tank04) 100000 - 0.96 * 100000 + (S.L.bremse_p_Tank04)
    {endif}
  {endif}

{end}

